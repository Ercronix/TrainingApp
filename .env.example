# Copy this file to .env and fill in the values before running docker compose up

# PostgreSQL
POSTGRES_DB=training_db
POSTGRES_USER=training_user
POSTGRES_PASSWORD=change_me_strong_password

# JWT – use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change_me_long_random_jwt_secret_here
JWT_EXPIRATION=86400000

# CORS – the public URL your frontend is served from
# Example: http://123.45.67.89  or  https://training.yourdomain.com
CORS_ALLOWED_ORIGINS=http://your-server-ip-or-domain
