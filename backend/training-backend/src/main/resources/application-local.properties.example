# Settings for the default `local` profile. Copy to application-local.properties (gitignored)
# in this directory and fill in the values.

# At least 32 characters; generate one with: openssl rand -hex 32
jwt.secret=change_me_run_openssl_rand_hex_32

# Same as POSTGRES_PASSWORD in backend/.env
spring.datasource.password=change_me

# Where the web app is served from: Expo's dev server (8081) and the run-app skill (8082).
# Add your LAN address too (e.g. http://192.168.1.20:8081) to open the web app from another device.
cors.allowed.origins=http://localhost:8081,http://localhost:8082
